# Environment of the example service, read only by src/config.ts (process.env, directly into the app config).
# In Docker / Kubernetes set these in the container environment; for local runs copy to example/.env (Bun loads it).
BASE_NAME=CORE
PORT=4000
CORE_SERVICE_NAME=example-service

# Modules of src/config.ts that are NOT registered (comma list), e.g. audit-log
CORE_MODULES_DISABLED=

# Base database: tenant registry core.tenants (search_path from options). Tenant URLs are rows of that table.
CORE_DB_URL=postgresql://postgres:postgres@localhost:5432/app?options=-c%20search_path%3Dcore
CORE_DB_POOL_SIZE=10
CORE_DB_TENANT_EVENTS=true

# JWT (same secret as the other services of the stack; there is no default)
CORE_API_JWT_SECRET=change-me
CORE_API_JWT_EXPIRES_IN=900
CORE_API_JWT_MAX_EXPIRES_IN=36000

# Logs: console JSON lines always, Kafka when CORE_KAFKA_LOG_SEND=true
CORE_LOG_LEVEL=info
CORE_LOG_RESPONSE=false
CORE_LOG_MASK_KEYS=email,mobile,tel_code,telCode,phone,password,token,authorization,pic,secret
CORE_KAFKA_LOG_SEND=true
# "app-logs" = one topic, key = tenant id.  "app-logs-{tenant}" = one topic per tenant (app-logs-acme ...)
CORE_KAFKA_LOG_TOPIC=app-logs
CORE_KAFKA_LOG_FLUSH_MS=500
CORE_KAFKA_LOG_BATCH_SIZE=200
CORE_KAFKA_LOG_QUEUE_MAX=10000

# Kafka connection
CORE_KAFKA_BROKERS=localhost:9092
CORE_KAFKA_SSL=false
# CORE_KAFKA_USERNAME=
# CORE_KAFKA_PASSWORD=
# CORE_KAFKA_SASL_MECHANISM=plain

# Other services called with AppHttp
CORE_API_BASE_URL=http://localhost:4000
