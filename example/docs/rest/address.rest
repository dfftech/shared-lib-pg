# Environment
@hosturl = http://localhost:4000
@authToken =
@xTenantId = acme

### 1. Address Save
POST {{hosturl}}/address-save
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
x-branch-id: main
Content-Type: application/json

{
  "id": "64f50ed5-c754-4bbb-980a-adf93a6d868e",
  "address": "123 Main Street",
  "area": "Downtown",
  "city": "Toronto",
  "state": "ON",
  "country": "CA",
  "zipCode": "M5H 2N2",
  "type": "billing",
  "lat": 43.6532,
  "lng": -79.3832
}

### 2. Address Search
POST {{hosturl}}/address-search
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{
  "searchTerm": "Toronto",
  "type": "bill",
  "limit": 10,
  "skip": 0,
  "orderBy": "city",
  "order": "ASC"
}

### 3. Address Entity
GET {{hosturl}}/address-entity/64f50ed5-c754-4bbb-980a-adf93a6d868e
Authorization: Bearer {{authToken}}
x-tenant-id: {{xTenantId}}

### 4. Same id, other tenant (separate database -> data null)
GET {{hosturl}}/address-entity/64f50ed5-c754-4bbb-980a-adf93a6d868e
x-tenant-id: globex

### 5. Validation error (422 INVALID_DATA, address missing)
POST {{hosturl}}/address-save
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{ "type": "billing" }

### 6. AppError (200 { data: null, error: "INVALID_ADDRESS" })
POST {{hosturl}}/address-save
x-tenant-id: {{xTenantId}}
Content-Type: application/json

{ "address": "   ", "type": "billing" }

### 7. No tenant (400 TENANT_REQUIRED) / unknown tenant (404 TENANT_NOT_FOUND)
POST {{hosturl}}/address-search
Content-Type: application/json

{}
